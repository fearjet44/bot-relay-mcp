{
  "name": "bot-relay-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted MCP message relay and real-time push hub (SSE + LAN/Tailnet webhooks) for AI bots with invite-code self-registration, Web Admin UI, Docker and My Own Data Center support",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "dev": "node --disable-warning=ExperimentalWarning src/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec test/*.test.ts",
    "hash-token": "node scripts/hash-token.mjs",
    "create-invite": "node --disable-warning=ExperimentalWarning scripts/create-invite.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fearjet44/bot-relay-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
